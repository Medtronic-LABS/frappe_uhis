# The deploy job (.github/workflows/docker-publish.yml) writes the real .env on
# the production host from these same names as GitHub repo secrets -- it is
# CI-owned and rewritten on every deploy, not hand-edited there. This file is
# only for a manual/local `docker compose up -d` against docker-compose.yml.
# Copy to .env and fill in real values for that. Never commit the real .env.

SITE_NAME=
ADMIN_PASSWORD=

# Existing Postgres database/schema -- shared with another service. This image
# never creates or drops the database itself: bench new-site --no-setup-db
# requires DB_USER to already have CREATE/USAGE on DB_SCHEMA.
# See docs/superpowers/specs/2026-09-18-postgres-reuse-design.md.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=
